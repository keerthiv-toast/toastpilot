{
  "name": "@toast/toastpilot-unified-inventory",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "ToastPilot — Autonomous QA Agent + Leadership Copilot for ToastUnifiedInventory",
  "scripts": {
    "agent": "tsx scripts/demo.ts",
    "demo": "tsx scripts/demo.ts",
    "setup": "tsx scripts/setup-appium.ts",
    "postinstall": "tsx scripts/setup-appium.ts || true",
    "appium": "node_modules/.bin/appium --port 4723",
    "app:build": "tsx scripts/build-operator-app.ts",
    "dev": "concurrently -k -n appium,server,dashboard -c yellow,cyan,magenta \"npm run appium\" \"sleep 8 && npm run dev:server\" \"sleep 10 && npm run dev:dashboard\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "build": "npm run build:dashboard && tsc -p tsconfig.json",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "start": "node dist/server/index.js",
    "agent:cycle-count": "tsx agent/cli.ts \"Test Cycle Count inventory flow\"",
    "agent:run": "tsx agent/cli.ts",
    "simulator:boot": "tsx scripts/boot-simulator.ts",
    "locators:generate": "tsx scripts/generate-locators.ts",
    "locators:generate:all": "tsx scripts/generate-locators.ts --all",
    "feature:generate": "tsx scripts/generate-feature.ts"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "appium": "^3.1.1",
    "appium-xcuitest-driver": "^10.6.0",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "webdriverio": "^9.20.0"
  }
}
