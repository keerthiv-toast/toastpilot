# Copy to .env and fill in credentials before running:
#   cp .env.example .env

# --- Required: Test account credentials ---
TOAST_TEST_EMAIL=
TOAST_TEST_PASSWORD=

# --- Optional: OpenAI (rule-based fallback when unset) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Build ---
XCODE_SCHEME=ToastOperator Production
AGENT_FORCE_REBUILD=false

# --- Simulator / Appium ---
IOS_DEVICE_NAME=iPhone 17 Pro
IOS_PLATFORM_VERSION=
IOS_SIMULATOR_UDID=
TOAST_OPERATOR_APP_PATH=../automation/app/ToastOperator.app
AGENT_NO_RESET=true

# --- Agent ---
# Set to "true" only for hackathon demo — OFF by default
# AGENT_DEMO_INJECT_FAILURE=true
AGENT_SERVER_PORT=9477
AGENT_DASHBOARD_PORT=5177

# --- Optional: Copilot preflight (leadership panels) ---
COPILOT_GIT_BASE=main

# --- Slack integration (optional: enables Send Slack Report button) ---
# Incoming webhook URL from https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
# Your name shown in Slack reports (defaults to the test email)
SLACK_REPORTER_NAME=

# --- Jira integration (required for Jira Test Planner) ---
# Your company Jira base URL, e.g. https://toasttab.atlassian.net
JIRA_BASE_URL=
# Your Atlassian account email
JIRA_USER_EMAIL=
# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Project key for auto-created bug tickets (e.g. SMB, PROJ)
JIRA_PROJECT_KEY=
# Optional: custom field ID for Acceptance Criteria (default: customfield_10500)
# JIRA_AC_FIELD=customfield_10500

# --- Autonomous PR-merge QA (optional: enables /api/webhook/pr-merged) ---
# Secret shared with GitHub Actions to verify webhook payloads (set in GitHub repo Settings → Secrets)
# Leave blank for dev/internal use (no signature verification)
GITHUB_WEBHOOK_SECRET=
# Public URL this agent server is reachable at from GitHub Actions runners
# e.g. http://160.253.x.x:9477  (internal network, no ngrok needed for self-hosted runners)
AGENT_PUBLIC_URL=
# GitHub personal access token for fetching PR diffs (enables Dynamic Flow Generator)
# Needs read:repo scope on github.toasttab.com
# Create at: https://github.toasttab.com/settings/tokens
GITHUB_TOKEN=
# Full repo path e.g. toasttab/operator-app-ios
GITHUB_REPO=toasttab/operator-app-ios
# GitHub Enterprise API host (no https://, no trailing slash)
GITHUB_API_HOST=github.toasttab.com/api/v3
